rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matching request.auth.uid)
    // Fields:
    //   - uid: string (required, immutable)
    //   - email: string (required)
    //   - displayName: string (required)
    //   - role: string ("student" | "alumni", required)
    //   - classYear: string (optional)
    //   - department: string (optional)
    //   - company: string (optional)
    //   - updatedAt: timestamp (optional)
    //
    // Collection: jobs
    // Document ID: {jobId}
    // Fields:
    //   - title: string (required)
    //   - company: string (required)
    //   - location: string (required)
    //   - type: string (required)
    //   - level: string (required)
    //   - referral: bool (optional)
    //   - featured: bool (optional)
    //   - deadline: string (optional)
    //   - createdAt: timestamp (optional)
    //
    // Collection: events
    // Document ID: {eventId}
    // Fields:
    //   - title: string (required)
    //   - month: string (required)
    //   - day: string (required)
    //   - location: string (required)
    //   - isVirtual: bool (required)
    //   - imageUrl: string (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidEmail(email) {
      return email is string && email.size() > 3 && email.size() < 150;
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() < 100 &&
             isValidEmail(data.email) &&
             data.role in ['student', 'alumni'];
    }

    // ===============================================================
    // Collection Security Rules
    // ===============================================================

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                      request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);
    }

    // Jobs Collection
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Alumni Collection
    match /alumni/{alumniId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
