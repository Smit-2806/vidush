rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matching request.auth.uid)
    // Fields:
    //   - uid: string (required, immutable)
    //   - email: string (required)
    //   - displayName: string (required)
    //   - role: string ("student" | "alumni" | "admin", required)
    //   - classYear: string (optional)
    //   - department: string (optional)
    //   - company: string (optional)
    //   - updatedAt: timestamp (optional)
    //
    // Collection: jobs
    // Document ID: {jobId}
    // Fields:
    //   - title: string (required)
    //   - company: string (required)
    //   - location: string (required)
    //   - type: string (required)
    //   - level: string (required)
    //   - referral: bool (optional)
    //   - featured: bool (optional)
    //   - deadline: string (optional)
    //   - createdAt: timestamp (optional)
    //
    // Collection: events
    // Document ID: {eventId}
    // Fields:
    //   - title: string (required)
    //   - month: string (required)
    //   - day: string (required)
    //   - location: string (required)
    //   - isVirtual: bool (required)
    //   - imageUrl: string (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function hasRole(roles) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidEmail(email) {
      return email is string && email.size() > 3 && email.size() < 150;
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() < 100 &&
             isValidEmail(data.email) &&
             data.role in ['student', 'alumni', 'admin'];
    }

    // ===============================================================
    // Collection Security Rules
    // ===============================================================

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) &&
                    request.resource.data.role in ['student', 'alumni'];
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                    request.resource.data.uid == resource.data.uid &&
                    request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // Jobs Collection
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if hasRole(['alumni']) &&
                    request.resource.data.postedBy == request.auth.uid;
      allow update: if isAdmin() ||
                    (hasRole(['alumni']) && resource.data.postedBy == request.auth.uid &&
                     request.resource.data.postedBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /applications/{applicationId} {
      allow read: if isAuthenticated() &&
        (resource.data.applicantId == request.auth.uid ||
         resource.data.posterId == request.auth.uid || isAdmin());
      allow create: if hasRole(['student']) &&
        request.resource.data.applicantId == request.auth.uid &&
        request.resource.data.applicantRole == 'student' &&
        request.resource.data.status == 'Under Review' &&
        exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.postedBy == request.resource.data.posterId;
      allow update: if isAdmin() ||
        (hasRole(['alumni']) && resource.data.posterId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
         request.resource.data.status in ['Under Review', 'Selected', 'Rejected']);
      allow delete: if isAdmin();
    }

    match /eventApplications/{applicationId} {
      allow read: if isAuthenticated() && resource.data.studentUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.studentUid == request.auth.uid &&
                    request.resource.data.status == 'registered' &&
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student' &&
                    exists(/databases/$(database)/documents/events/$(request.resource.data.eventId)) &&
                    get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.title == request.resource.data.eventTitle;
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.studentUid == request.auth.uid;
    }

    // Alumni Collection
    match /alumni/{alumniId} {
      allow read: if true;
      allow create, update: if isAdmin() ||
        (hasRole(['alumni']) && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
